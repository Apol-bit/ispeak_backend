# Default deny: only production dependencies and application source enter the build.
**
!Dockerfile
!package.json
!package-lock.json
!server.js
!controllers/
!controllers/**
!middleware/
!middleware/**
!models/
!models/**
!routes/
!routes/**
!services/
!services/**
!docker/
!docker/**

# Defense in depth for accidentally nested local artifacts.
**/.env*
**/.git/
**/node_modules/
**/__pycache__/
**/.cache/
**/uploads/
**/recordings/
**/build/
**/dist/
**/coverage/
**/*.log
**/*.tmp
**/*.temp
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/key.properties
**/credentials.json
**/service-account*.json
**/*.wav
**/*.mp3
**/*.m4a
**/*.aac
**/*.flac
**/*.ogg
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
