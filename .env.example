PORT=5000
MONGO_URI=your_connection_string_here
# Production: set MONGO_URI in the server secret manager, not MONGODB_URI.
# Atlas format (placeholder only): mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/ispeak?retryWrites=true&w=majority
# Include an explicit database name; retain TLS/certificate verification.
JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=7d
JWT_ISSUER=ispeak-api
JWT_AUDIENCE=ispeak-clients
TERMS_VERSION=1.0
AUTH_RATE_LIMIT_MAX=20
# Unset preserves open registration outside production. Production MUST set a mode.
# Railway Testing: REGISTRATION_MODE=invite; use closed to stop new registrations.
# Do not set open as a shared/default cloud variable.
# REGISTRATION_MODE=invite
# JSON object: approved email -> SHA-256 hex hash of its unique 32-byte base64url code.
# Set this privately in Railway Testing; never store plaintext codes here.
# REGISTRATION_INVITES_JSON={"tester@example.invalid":"<64-character SHA-256 hex hash>"}
PYTHON_BACKEND_URL=http://127.0.0.1:8000
PYTHON_TIMEOUT_MS=300000
# Required in production; same private secret as Python ISPEAK_SERVICE_TOKEN.
PYTHON_SERVICE_TOKEN=
# Explicit trusted ingress IPs/CIDRs only. Empty ignores forwarded headers.
# Verify the host ingress contract before setting; never use true or /0.
TRUST_PROXY_CIDRS=
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=uploads
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
RECORDING_RETENTION_DAYS=30

# Per authenticated user, not shared-network IP. One in-flight upload per user.
ANALYSIS_RATE_LIMIT_MAX=10

# Production audio: set STORAGE_DRIVER=r2. Keep the audio bucket private.
# Configure credentials only in the server's environment/secret manager.
# Either R2_ACCOUNT_ID or an explicit R2_ENDPOINT is required.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
